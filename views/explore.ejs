<!DOCTYPE html>
<html lang="en">

<head>
    <%-include('_head')%>
    <title>Safar | Explore</title>
    <link rel="stylesheet" href="/css/explore.css">
    <script src="https://kit.fontawesome.com/e9cb9b0869.js" crossorigin="anonymous"></script>
</head>

<body>
    <%-include('header')%>
        <div class="main">
            <% for(let i of reviews){ %>
                <div class="review">
                    <div class="left">
                        <img class="img" src="<%=i.image%>" alt="">
                        <h1 class="user">
                            <%=i.username%>
                        </h1>
                    </div>
                    <div class="right">
                        <h1 class="data"><span>Location: </span>
                            <%=i.location%>
                        </h1>
                        <h1 class="data"><span>Experience:</span>
                            <%=i.experience%>
                        </h1>
                        <h1 class="data"><span>Places to Visit:</span>
                            <%=i.places%>
                        </h1>
                        <h1 class="data"><span>Rating:</span>
                            <%=i.rating%>
                        </h1>
                        <h1 class="data"><span>Expenditure:</span>
                            <%=i.expenditure%>
                        </h1>
                        <div class="delete-btn"> <a href="/delete-review/?id=<%= i._id %>">Delete </a><i class="fas fa-trash"></i></div>
                    </div>
                </div>
                <% } %>
        </div>
        <%-include('footer')%>
</body>

</html>
