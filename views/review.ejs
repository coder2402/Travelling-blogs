<!DOCTYPE html>
<html lang="en">

<head>
    <%-include('_head')%>
    <title>Safar | Review</title>
    <link rel="stylesheet" href="/css/review.css">
</head>

<body>
    <%-include('header')%>
        <div class="main">
            <div class="main-content">
                <form action="/add-review" method="post">

                    <div><input type="text" placeholder="Name" name="username"></div>
                    <div><input type="text" placeholder="Location" name="location"></div>
                    <div><input type="text" placeholder="Image URL" name="image"></div>
                    <div><input type="text" placeholder="Experience" name="experience"></div>
                    <div><input type="number" placeholder="Rating" name="rating"></div>
                    <div><input type="text" placeholder="Places" name="places"></div>
                    <div><input type="number" placeholder="Expenditure for 2" name="expenditure"></div>
                    <div><button type="submit">Submit</button></div>
                </form>
            </div>
        </div>
        <%-include('footer')%>
</body>

</html>
