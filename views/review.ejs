<!DOCTYPE html>
<html lang="en">

<head>
    <%-include('_head')%>
    <title>Safar | Review</title>
    <link rel="stylesheet" href="/css/review.css">
</head>

<body>
    <%-include('header')%>
        <div class="main">
            <div class="main-content">
                <form action="/add-review" method="post">

                    <div><input type="text" placeholder="Name" name="username" aria-label="Name" required></div>
                    <div><input type="text" placeholder="Location" name="location" aria-label="Location" required></div>
                    <div><input type="url" placeholder="Image URL" name="image" aria-label="Image URL" required></div>
                    <div><input type="text" placeholder="Experience" name="experience" aria-label="Experience" required></div>
                    <div><input type="number" placeholder="Rating" name="rating" aria-label="Rating" min="1" max="5" required></div>
                    <div><input type="text" placeholder="Places" name="places" aria-label="Places" required></div>
                    <div><input type="number" placeholder="Expenditure for 2" name="expenditure" aria-label="Expenditure for 2" min="0" required></div>
                    <div><button type="submit">Submit</button></div>
                </form>
            </div>
        </div>
        <%-include('footer')%>
</body>

</html>
